# Copy this file to .env and fill in real values.

PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/dbname
# IMPORTANT: must be the EXACT SAME value as JWT_SECRET in the payment
# gateway backend's .env — the admin dashboard logs in here, and that
# service trusts these tokens directly for its own admin routes.
JWT_SECRET=

# Google OAuth (mobile + web sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Allowed origin for the cookie-session based app.js entrypoint (not used by
# src/server.js, which is the file actually started by `npm start`/`npm run dev`)
CLIENT_URL=

# Paystack (src/routes/payment.js, src/routes/wallet.routes.js webhook)
PAYSTACK_SECRET_KEY=

# Shared secret the paymentgatewaybackend service sends as X-Internal-Key
# when calling POST /appointments/create after a successful deposit.
# Must match INTERNAL_API_KEY in that service's .env.
INTERNAL_API_KEY=

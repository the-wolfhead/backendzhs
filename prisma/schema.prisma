datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  name      String
  googleId  String?  @unique
  picture   String?
  role      String   @default("USER") // USER | DOCTOR | SUPER_ADMIN | TECH_SUPPORT | CUSTOMER_CARE | FINANCE | AUDITOR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  wallet Wallet?
  transactions Transaction[]

  // 🩺 Medical Information
  bloodGroup     String?
  genotype       String?
  medicalHistory String[]
  allergies      String[]

  // 🧬 Lifestyle
  smoker     Boolean? @default(false)
  alcoholUse String?
  drugUse    Boolean? @default(false)

  // 🔗 Relations
  appointments    Appointment[]
  favoriteDoctors FavoriteDoctor[]
  doctorProfile   Doctor?
  dependents      Dependent[]
}

model Dependent {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  relationship String    // e.g. "Spouse", "Child", "Parent"
  dateOfBirth  DateTime?
  bloodGroup   String?
  genotype     String?
  allergies    String?
  createdAt    DateTime  @default(now())
}

enum TransactionType {
TOPUP
PAYMENT
REFUND
}


enum TransactionChannel {
CARD
BANK_TRANSFER
USSD
WALLET
}


enum TransactionStatus {
PENDING
SUCCESS
FAILED
REFUNDED
}



model Wallet {
id String @id @default(cuid())
user User @relation(fields: [userId], references: [id])
userId String @unique
balance BigInt @default(0) // store in kobo (subunits)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}


model Transaction {
id String @id @default(cuid())
user User @relation(fields: [userId], references: [id])
userId String
type TransactionType
channel TransactionChannel
amount BigInt // stored in kobo
currency String @default("NGN")
status TransactionStatus @default(PENDING)
reference String? @unique
paystackResponse Json?
meta Json?
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}


model Doctor {
  id             Int      @id @default(autoincrement())
  name           String
  specialty      String[]
  rating         Float?   @default(0)
  bio            String?
  picture        String?
  availableHours Json?
  workDays       String[]
  isOnline       Boolean  @default(false)
  fee            Int      @default(3000)
  createdAt      DateTime @default(now())

  // Links this practice profile to a login identity (User with role=DOCTOR).
  // Optional because a Doctor row can exist in the directory before the
  // doctor has been onboarded with actual login credentials.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // 🔗 Relations
  appointments Appointment[]
  favoritedBy  FavoriteDoctor[]
}

model Appointment {
  id       Int    @id @default(autoincrement())

  // One of doctor / hospital / lab is set depending on type
  doctor     Doctor?   @relation(fields: [doctorId], references: [id])
  doctorId   Int?

  hospital   Hospital? @relation(fields: [hospitalId], references: [id])
  hospitalId Int?

  lab        Lab?      @relation(fields: [labId], references: [id])
  labId      Int?

  // DOCTOR | HOSPITAL | LAB
  type String @default("DOCTOR")

  // For lab: which test/service; for hospital: reason/clinic
  service String?

  user   User   @relation(fields: [userId], references: [id])
  userId String

  date DateTime
  time String

  patientName      String   @default("Self")
  amount           Float?
  paymentReference String?  @unique
  paymentStatus    String   @default("PENDING")
  source           String   @default("DIRECT")
  metadata         Json?

  // Only relevant for doctor (video) appointments; optional for hospital/lab
  videoCallUrl  String?
  callStartedAt DateTime?
  callEndedAt   DateTime?

  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Hospital {
  id           Int      @id @default(autoincrement())
  name         String
  address      String
  phone        String?
  email        String?
  specialty    String[]
  // Optional default consultation fee for booking
  fee          Int      @default(5000)
  availableHours Json?
  workDays     String[]
  createdAt    DateTime @default(now())

  appointments Appointment[]
}

model Lab {
  id           Int      @id @default(autoincrement())
  name         String
  services     String
  address      String
  phone        String?
  email        String?
  // Optional default fee
  fee          Int      @default(8000)
  availableHours Json?
  workDays     String[]
  createdAt    DateTime @default(now())

  appointments Appointment[]
}

model Pharmacy {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
}

model FavoriteDoctor {
  id       Int    @id @default(autoincrement())
  userId   String
  doctorId Int

  user   User   @relation(fields: [userId], references: [id])
  doctor Doctor @relation(fields: [doctorId], references: [id])
}
